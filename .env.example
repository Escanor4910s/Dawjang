# Supabase Configuration (required)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# These are non-VITE_ prefixed — they are NOT exposed to the browser
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# IMPORTANT: Never add SUPABASE_SERVICE_ROLE_KEY here.
# It belongs in Supabase Edge Function environment variables only.
